<Window x:Class="CSharpToUppaal.GUI.ProjectSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select UPPAAL Target Project"
        Width="900" Height="430"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Choose the one C# project to convert. Referenced projects resolve types and calls, but only the selected project's source becomes UPPAAL templates."/>
        <ListBox Grid.Row="1" x:Name="ProjectsList" DisplayMemberPath="DisplayName"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" Padding="14,6"/>
            <Button Content="Use Selected Project" IsDefault="True" Click="UseSelectedProject_Click" Padding="14,6"/>
        </StackPanel>
    </Grid>
</Window>
