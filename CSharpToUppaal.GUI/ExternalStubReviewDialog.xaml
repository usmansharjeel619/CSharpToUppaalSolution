<Window x:Class="CSharpToUppaal.GUI.ExternalStubReviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review External Stub Assumptions"
        Width="720" Height="520" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Review external calls" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                           Text="The selected model calls code outside the target project or code that cannot be resolved. Each call below will be represented as a bounded nondeterministic UPPAAL stub."
                           Margin="0,0,0,16"/>
                <TextBlock x:Name="CallCount" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBox x:Name="CallDetails" IsReadOnly="True" TextWrapping="Wrap"
                         FontFamily="Consolas" FontSize="13" Padding="12"
                         Background="{StaticResource PrimaryDarkBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                         HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="External calls to review"/>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Continue with these assumptions, or cancel model generation."
                       TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="96" Height="40"
                        Margin="0,0,12,0" Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="{StaticResource PrimaryLightBrush}"/>
                <Button Content="Continue" MinWidth="110" Height="40" Click="Continue_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
